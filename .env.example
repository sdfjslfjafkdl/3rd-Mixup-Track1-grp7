# Solar Pro3 API
SOLAR_API_KEY=sk_...
SOLAR_MODEL=solar-pro-3

# Upstage Document Parse
# 기본적으로 SOLAR_API_KEY를 재사용하고, 별도 키가 있으면 UPSTAGE_API_KEY로 덮어쓸 수 있음
UPSTAGE_API_KEY=
UPSTAGE_DOCUMENT_PARSE_URL=https://api.upstage.ai/v1/document-digitization
UPSTAGE_DOCUMENT_PARSE_MODEL=document-parse
UPSTAGE_DOCUMENT_PARSE_OCR=force
UPSTAGE_DOCUMENT_PARSE_BASE64_ENCODING=['table']

# 나라장터 입찰공고 (선택, 처음엔 mock)
NARAJANGTEO_SERVICE_KEY=...

# 서버
SERVER_PORT=8000
LOG_LEVEL=INFO

# CORS 허용 도메인 (콤마로 구분, 비워두면 데모용으로 모두 허용)
# 예: CORS_ORIGINS=https://app.lovable.dev,https://example.com
CORS_ORIGINS=
